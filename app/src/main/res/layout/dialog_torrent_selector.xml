<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E00D1117"
    android:paddingHorizontal="36dp"
    android:paddingVertical="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/surface_layer"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDialogTorrentHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ TOR"
                    android:textColor="#00E5FF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDialogTorrentSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Prioridad: Español/Latino > Dual Audio > Seeds"
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Quick Settings Button -->
            <Button
                android:id="@+id/btnTorrentQuickSettings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:text="⚙ Ajustes"
                android:textColor="@color/primary_text"
                android:textSize="13sp" />

            <!-- Close Button -->
            <Button
                android:id="@+id/btnDialogClose"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:text="✕ Cerrar"
                android:textColor="@color/primary_text"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/surface_border" />

        <!-- Episode Switcher Row (Symmetric Navigation) -->
        <LinearLayout
            android:id="@+id/layoutEpisodeNavigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTorrentEpFirst"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="14dp"
                android:text="⏮ Primero"
                android:textColor="@color/primary_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTorrentEpPrev"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="14dp"
                android:text="◀ Anterior"
                android:textColor="@color/primary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtTorrentCurrentEp"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="Temporada 1 • Ep. 1"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTorrentEpNext"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="14dp"
                android:text="Siguiente ▶"
                android:textColor="@color/primary_text"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTorrentEpLast"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="14dp"
                android:text="Último ⏭"
                android:textColor="@color/primary_text"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Provider Filter Bar (Horizontal Tabs / Chips) -->
        <HorizontalScrollView
            android:id="@+id/scrollProviderFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/rgProviderFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Progress Spinner -->
        <ProgressBar
            android:id="@+id/progressBarTorrents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="24dp"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <!-- Empty State Label -->
        <TextView
            android:id="@+id/txtEmptyTorrents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:gravity="center"
            android:text="Buscando fuentes torrent..."
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />

        <!-- Torrent Stream Recycler (Wide and Spacious for 75" TV) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTorrents"
            android:layout_width="match_parent"
            android:layout_height="480dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
