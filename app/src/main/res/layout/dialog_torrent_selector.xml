<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D0000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="740dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#151722"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDialogTorrentHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Torrents"
                    android:textColor="#00E5FF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDialogTorrentSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Prioridad: Español/Latino > Dual Audio > Seeds"
                    android:textColor="#8F94A6"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Quick Settings Button -->
            <Button
                android:id="@+id/btnTorrentQuickSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text="⚙ Ajustes"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Close Button -->
            <Button
                android:id="@+id/btnDialogClose"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text="✕ Cerrar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#2E3244" />

        <!-- Episode Switcher Row (Symmetric Navigation) -->
        <LinearLayout
            android:id="@+id/layoutEpisodeNavigator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnTorrentEpFirst"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:text="⏮ Primero"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTorrentEpPrev"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:text="◀ Anterior"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtTorrentCurrentEp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="Temporada 1 • Ep. 1"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTorrentEpNext"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:text="Siguiente ▶"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTorrentEpLast"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="10dp"
                android:text="Último ⏭"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Progress Spinner -->
        <ProgressBar
            android:id="@+id/progressBarTorrents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone" />

        <!-- Empty State Label -->
        <TextView
            android:id="@+id/txtEmptyTorrents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:gravity="center"
            android:text="Buscando fuentes torrent..."
            android:textColor="#B0B3C6"
            android:textSize="13sp" />

        <!-- Torrent Stream Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTorrents"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
