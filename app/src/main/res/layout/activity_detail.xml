<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_canvas">

    <!-- Backdrop Background Image with Dark Vignette -->
    <ImageView
        android:id="@+id/imgDetailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@drawable/bg_bottom_fader" />

    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:padding="@dimen/safe_zone_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Top Row: Poster + Core Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- High-Res Cover Poster Card -->
                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="280dp">

                    <ImageView
                        android:id="@+id/imgDetailPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/surface_layer"
                        android:contentDescription="@null" />

                </FrameLayout>

                <!-- Information Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_text"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Source + Rating Metadata -->
                    <TextView
                        android:id="@+id/txtDetailMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#FFD54F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Runtime / Certification / TMDB Genres badges (movies & shows) -->
                    <TextView
                        android:id="@+id/txtMovieBadges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- Synopsis -->
                    <TextView
                        android:id="@+id/txtDetailSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        style="@style/TextAppearance.BodyText" />

                    <!-- Director / Cast (from TMDB credits) -->
                    <TextView
                        android:id="@+id/txtMovieCredits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        style="@style/TextAppearance.MetadataLabel"
                        android:visibility="gone" />

                    <!-- Symmetrical Action Buttons (Scrollable so never clipped) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Action row: icon-only at rest, label reveals on D-pad focus
                                 (see IconRevealButton). Order: WEB, TOR, Reiniciar, Tráiler,
                                 Mi Lista, Visto. Ajustes/Volver live in the top bar / system back. -->
                            <Button
                                android:id="@+id/btnPlayFirst"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_netflix_btn_play"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="18dp"
                                android:text="▶"
                                android:textColor="@color/color_netflix_btn_play"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnPlayTorrent"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_netflix_btn_secondary"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="18dp"
                                android:text="⚡"
                                android:textColor="#00E5FF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnRestartEpisode"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_netflix_btn_secondary"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="16dp"
                                android:text="↺"
                                android:textColor="@color/primary_text"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <Button
                                android:id="@+id/btnTrailer"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_netflix_btn_secondary"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="14dp"
                                android:text=""
                                android:textColor="@color/primary_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnToggleFavorite"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_netflix_btn_secondary"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="16dp"
                                android:text="+"
                                android:textColor="@color/primary_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnToggleWatched"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_netflix_btn_secondary"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:paddingHorizontal="14dp"
                                android:text=""
                                android:textColor="@color/primary_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

            <!-- Episodes Section Header with Sort and Jump Controls -->
            <LinearLayout
                android:id="@+id/layoutEpisodesHeaderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txtEpisodesHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Episodios Disponibles"
                    style="@style/TextAppearance.SectionHeader" />

                <!-- Sort Order Toggle (1 -> N or N -> 1) -->
                <Button
                    android:id="@+id/btnSortOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_topbar_item"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="12dp"
                    android:text="⇄ Orden: 1 ➔ N"
                    android:textColor="@color/primary_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Jump to First Episode -->
                <Button
                    android:id="@+id/btnJumpStart"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_topbar_item"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="10dp"
                    android:text="⏮ Primero"
                    android:textColor="@color/primary_text"
                    android:textSize="12sp" />

                <!-- Jump to Last Episode -->
                <Button
                    android:id="@+id/btnJumpEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_topbar_item"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="10dp"
                    android:text="⏭ Último"
                    android:textColor="@color/primary_text"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Season Selection Capsules (Stremio / Nuvio style) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSeasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingVertical="12dp"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- clipChildren="false" + vertical padding so a focused episode card's 110%
                 scale-up glow renders fully instead of being cut off against the row bounds. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingVertical="16dp"
                android:overScrollMode="never" />

        </LinearLayout>

    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarDetail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/active_accent"
        android:visibility="gone" />

</FrameLayout>
