<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_canvas">

    <!-- STATIC BACKGROUND IMAGE AND GRADIENTS -->
    <FrameLayout
        android:id="@+id/layoutDetailHeroBackground"
        android:layout_width="match_parent"
        android:layout_height="540dp"
        android:background="@color/surface_layer"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/imgDetailBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewDetailTextGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewDetailBottomGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Hero Section: ClearArt Logo, Actions, Synopsis, Metadata (Nuvio Layout) -->
            <FrameLayout
                android:id="@+id/layoutDetailHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="460dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/safe_zone_margin"
                    android:paddingTop="36dp"
                    android:paddingBottom="12dp">

                    <!-- ClearArt Logo (TMDB/Cinemeta transparent PNG) -->
                    <ImageView
                        android:id="@+id/imgDetailLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="84dp"
                        android:layout_marginBottom="14dp"
                        android:maxWidth="360dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:visibility="gone"
                        android:contentDescription="@null" />

                    <!-- Fallback Title when no Logo is available -->
                    <TextView
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        style="@style/TextAppearance.HeroTitle"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:shadowColor="#000000"
                        android:shadowRadius="10" />

                    <!-- Nuvio Action Buttons Row directly under Logo -->
                    <LinearLayout
                        android:id="@+id/layoutActionButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:gravity="center_vertical"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Main CTA: White Pill (e.g. ▶ Next S1 E11) -->
                        <Button
                            android:id="@+id/btnPlayFirst"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_nuvio_btn_play"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:paddingHorizontal="22dp"
                            android:text="▶ Next S1 E1"
                            android:textColor="#101216"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Torrent Stream Action: Translucent Dark Pill (⚡ Torrent) -->
                        <Button
                            android:id="@+id/btnPlayTorrent"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_nuvio_btn_secondary"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:paddingHorizontal="18dp"
                            android:text="⚡ Torrent"
                            android:textColor="#00E5FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Favorite / List Button -->
                        <Button
                            android:id="@+id/btnToggleFavorite"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_nuvio_btn_circle"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="0dp" />

                        <!-- Trailer Button -->
                        <Button
                            android:id="@+id/btnTrailer"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_nuvio_btn_circle"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:text="🎬"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:gravity="center"
                            android:padding="0dp" />

                        <!-- Watched Button -->
                        <Button
                            android:id="@+id/btnToggleWatched"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_nuvio_btn_circle"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:text="✓"
                            android:textColor="#81C784"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="0dp" />

                        <!-- Restart Button (if in-progress) -->
                        <Button
                            android:id="@+id/btnRestartEpisode"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_nuvio_btn_circle"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:text="↺"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:padding="0dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Director / Creator (Nuvio: Creator: Pendleton Ward) -->
                    <TextView
                        android:id="@+id/txtMovieCredits"
                        android:layout_width="720dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#B0B8C4"
                        android:textSize="13sp"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:visibility="gone" />

                    <!-- Synopsis (3-4 lines, high contrast) -->
                    <TextView
                        android:id="@+id/txtDetailSynopsis"
                        android:layout_width="720dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="#E6EDF3"
                        android:textSize="14sp"
                        android:shadowColor="#000000"
                        android:shadowRadius="8" />

                    <!-- Metadata line: Genres • Year + Yellow IMDb Badge (Nuvio signature) -->
                    <LinearLayout
                        android:id="@+id/layoutDetailMetaRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtDetailMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:shadowColor="#000000"
                            android:shadowRadius="6" />

                        <LinearLayout
                            android:id="@+id/layoutDetailImdb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_imdb_badge"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="1dp"
                                android:text="IMDb"
                                android:textColor="#000000"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtDetailImdbScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:shadowColor="#000000"
                                android:shadowRadius="4"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Badges: [TV-PG | ENDED] • 11m • United States • EN -->
                    <TextView
                        android:id="@+id/txtMovieBadges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#8B949E"
                        android:textSize="12sp"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:visibility="gone" />

                </LinearLayout>

            </FrameLayout>

            <!-- Below-hero content: Season Capsules & Episode Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/safe_zone_margin"
                android:paddingTop="4dp">

                <!-- Season Selection Capsules (Nuvio: Season 1, Season 2) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSeasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingVertical="6dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <!-- Episodes List (16:9 full-bleed Nuvio cards) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEpisodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingVertical="8dp"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarDetail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/active_accent"
        android:visibility="gone" />

</FrameLayout>
