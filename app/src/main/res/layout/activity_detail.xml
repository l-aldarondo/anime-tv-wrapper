<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_canvas">

    <!-- STATIC BACKGROUND IMAGE AND GRADIENTS -->
    <FrameLayout
        android:id="@+id/layoutDetailHeroBackground"
        android:layout_width="match_parent"
        android:layout_height="620dp"
        android:background="@color/surface_layer"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/imgDetailBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewDetailTextGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewDetailBottomGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Main Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Space for hero text/buttons overlaid on the static background behind ScrollView -->
            <FrameLayout
                android:id="@+id/layoutDetailHero"
                android:layout_width="match_parent"
                android:layout_height="620dp"
                android:clipChildren="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/safe_zone_margin"
                    android:paddingBottom="28dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.HeroTitle"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:shadowColor="#000000"
                        android:shadowRadius="10" />



                    <!-- Director / Cast (from TMDB credits) -->
                    <TextView
                        android:id="@+id/txtMovieCredits"
                        android:layout_width="720dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="4dp"
                        style="@style/TextAppearance.MetadataLabel"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:visibility="gone" />

                    <!-- Synopsis -->
                    <TextView
                        android:id="@+id/txtDetailSynopsis"
                        android:layout_width="720dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="4"
                        android:ellipsize="end"
                        style="@style/TextAppearance.BodyText"
                        android:shadowColor="#000000"
                        android:shadowRadius="6" />

                    <!-- Genres • Year • Rating -->
                    <TextView
                        android:id="@+id/txtDetailMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#FFD54F"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowRadius="6" />

                    <!-- Certification • Runtime -->
                    <TextView
                        android:id="@+id/txtMovieBadges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/secondary_text"
                        android:textSize="12sp"
                        android:shadowColor="#000000"
                        android:shadowRadius="6"
                        android:visibility="gone" />

                </LinearLayout>

            </FrameLayout>

            <!-- Below-hero content keeps its own horizontal margin since the hero itself is
                 full-bleed (no ScrollView-wide padding anymore). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:paddingHorizontal="@dimen/safe_zone_margin"
                android:paddingTop="20dp">



            <!-- Symmetrical Action Buttons (Moved from top to here) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Action row: WEB, TOR, Reiniciar, Tráiler, Mi Lista, Visto -->
                    <Button
                        android:id="@+id/btnPlayFirst"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_netflix_btn_play"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="18dp"
                        android:text="▶"
                        android:textColor="@color/color_netflix_btn_play"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPlayTorrent"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="18dp"
                        android:text="⚡"
                        android:textColor="#00E5FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRestartEpisode"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="16dp"
                        android:text="↺"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnTrailer"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="14dp"
                        android:text=""
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnToggleFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="16dp"
                        android:text="+"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnToggleWatched"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="14dp"
                        android:text=""
                        android:textColor="@color/primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Episode Navigation & Sort Controls -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="4dp"
                        android:background="#44ffffff" />

                    <Button
                        android:id="@+id/btnJumpFirst"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:text="«"
                        android:textColor="@color/primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btnSortOrder"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:paddingHorizontal="14dp"
                        android:text="⇅ 1 ➔ N"
                        android:textColor="@color/primary_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnJumpLast"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_netflix_btn_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/recyclerSeasons"
                        android:text="»"
                        android:textColor="@color/primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="0dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Season Selection Capsules (Stremio / Nuvio style) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSeasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingVertical="12dp"
                android:overScrollMode="never"
                android:nextFocusUp="@id/btnPlayFirst"
                android:nextFocusDown="@id/recyclerEpisodes"
                android:visibility="gone" />

            <!-- Episodes list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingVertical="16dp"
                android:overScrollMode="never"
                android:nextFocusUp="@id/recyclerSeasons" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBarDetail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/active_accent"
        android:visibility="gone" />

</FrameLayout>
