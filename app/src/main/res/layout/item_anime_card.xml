<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvio-style poster card: pure poster artwork without title text underneath.
     CardView with 10dp radius strictly clips the poster image so sharp corners never spill out. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="165dp"
    android:layout_marginEnd="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardBackgroundColor="@color/surface_layer">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface_layer"
            android:contentDescription="@null" />

        <!-- Source Badge (e.g. SoloLatino / JKAnime) -->
        <TextView
            android:id="@+id/txtSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="#CC0A0B10"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="#FFD54F"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Episode / Rating Badge Overlay -->
        <TextView
            android:id="@+id/txtBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_netflix_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:textColor="@color/primary_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Hidden Title (retained for binding compatibility, 0dp height) -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Focus stroke overlay: perfectly matches the 10dp CardView contour -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_focus_border" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
