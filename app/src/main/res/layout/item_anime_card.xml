<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:layout_marginEnd="10dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:background="@drawable/bg_favorite_card">

    <!-- Poster with Badges Container (true 2:3 poster ratio at 132dp width) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="198dp">

        <ImageView
            android:id="@+id/imgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface_layer"
            android:contentDescription="@null" />

        <!-- Episode / Rating Badge Overlay -->
        <TextView
            android:id="@+id/txtBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_netflix_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/primary_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Source Badge (e.g. Latino / JKAnime) -->
        <TextView
            android:id="@+id/txtSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="#CC0A0B10"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="#FFD54F"
            android:textSize="10sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Anime Title. minLines locks this to always reserve 2 lines' worth of height, even for
         a short 1-line title, so every card in a row ends up the same total height regardless
         of title length. -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.CardTitle" />

</LinearLayout>
