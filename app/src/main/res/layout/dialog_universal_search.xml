<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_panel"
    android:padding="24dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Búsqueda Universal TV"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_netflix_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="NETFLIX STYLE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Escribe el nombre del anime, serie o película y selecciona en qué plataforma deseas buscar."
        android:textColor="#B0B3C6"
        android:textSize="13sp" />

    <!-- Query Input Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Título a buscar:"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_netflix_tab"
        android:padding="14dp"
        android:hint="Ej. Dragon Ball, Solo Leveling, Naruto..."
        android:textColorHint="#60647A"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Source Selector Pills -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Seleccionar Plataforma de Búsqueda:"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutSearchSourcePills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillSearchSoloLatino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_active_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="● SoloAnime"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearchSoloStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ SoloStream"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearch9Anime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ 9Anime"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearchGogoAnime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ GogoAnime"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearchAnimeFlix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ AnimeFlix"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearchAnimeYT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ AnimeYT"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/pillSearchJKAnime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_netflix_tab"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="○ JKAnime"
                android:textColor="#E0E0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/btnCancelSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_netflix_tab"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Cancelar"
            android:textColor="#E0E0FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnExecuteSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_netflix_badge"
            android:paddingHorizontal="22dp"
            android:paddingVertical="12dp"
            android:text="🔍 Buscar Ahora"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

</LinearLayout>
