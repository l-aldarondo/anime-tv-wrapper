<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="false">

    <!-- Primary TV WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Fullscreen Video Container (For WebChromeClient HTML5 Video) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Sleek Top Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/pageLoadingBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#9D4EDD"
        android:visibility="gone" />

    <!-- Virtual Cursor View for TV Remote Navigation -->
    <com.example.animetv.tv.VirtualCursorView
        android:id="@+id/virtualCursorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:clickable="false" />

    <!-- Top OSD Status Bar (Auto-updating Shield & Mode Badges) -->
    <LinearLayout
        android:id="@+id/osdTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:focusable="false"
        android:clickable="false">

        <!-- Quick Fullscreen Button -->
        <TextView
            android:id="@+id/btnFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_osd_badge"
            android:text="⛶ Fullscreen"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- AdBlock Shield Badge -->
        <TextView
            android:id="@+id/txtAdBlockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_osd_badge"
            android:text="🛡️ AdBlock ON (0)"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Navigation Mode Badge -->
        <TextView
            android:id="@+id/txtNavModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_osd_badge"
            android:text="🖱️ Pointer Mode"
            android:textColor="#E0AAFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Remote Controls Guide (Auto-fades out after 5 seconds) -->
    <LinearLayout
        android:id="@+id/osdControlsGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_panel"
        android:orientation="horizontal"
        android:focusable="false"
        android:clickable="false">

        <TextView
            android:id="@+id/txtGuideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 D-Pad: Move Pointer  •  OK: Click  •  [MENU]: Mode Toggle  •  [PLAY]: Play/Pause  •  [BACK]: Back"
            android:textColor="#F0F0FF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
