<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_canvas">

    <!-- 1. Full-screen backdrop artwork layer (Nuvio / Stremio TV Style)
         Spans the entire screen without any hard black boxes or artificial crops -->
    <FrameLayout
        android:id="@+id/layoutHeroBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgHeroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Left-to-right gradient: ensures title, logo, metadata, and synopsis are crisp
             over any backdrop while letting the artwork shine on the right -->
        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewHeroLeftGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom gradient: smoothly transitions down the screen without creating a solid black cut -->
        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewHeroBottomGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- 2. Main Content Layer: Full screen width (100% match_parent) for Hero artwork, info, and catalog rows -->
    <LinearLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

            <!-- Reactive Hero Information (Logo / Title, Metadata, Badges, Synopsis) -->
            <LinearLayout
                android:id="@+id/layoutHeroInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="145dp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/safe_zone_margin"
                android:paddingTop="18dp"
                android:paddingBottom="6dp">

            <!-- Official Transparent PNG Logo or Bold Fallback Title (Nuvio Signature) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="80dp">

                <ImageView
                    android:id="@+id/imgHeroLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:maxWidth="380dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/txtHeroTitle"
                    android:layout_width="580dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/primary_text"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#000000"
                    android:shadowRadius="10" />

            </FrameLayout>

            <!-- Primary Metadata line (e.g. S1 E11 • Wizard • Animación • 2010-2018) -->
            <TextView
                android:id="@+id/txtHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#C5C8D4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowRadius="6"
                android:visibility="gone" />

            <!-- Badges line: NEXT UP + IMDb rating pill (Nuvio signature) -->
            <LinearLayout
                android:id="@+id/layoutHeroBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtHeroNextUpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT UP"
                    android:textColor="#E0E3EB"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:shadowColor="#000000"
                    android:shadowRadius="4" />

                <LinearLayout
                    android:id="@+id/layoutHeroImdb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_imdb_badge"
                        android:text="IMDb"
                        android:textColor="#000000"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp" />

                    <TextView
                        android:id="@+id/txtHeroImdbScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:shadowColor="#000000"
                        android:shadowRadius="4" />
                </LinearLayout>

            </LinearLayout>

            <!-- Synopsis (compact 2 lines so catalog rows start high enough to peek the second row) -->
            <TextView
                android:id="@+id/txtHeroSynopsis"
                android:layout_width="540dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minLines="2"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#B0B4C3"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:shadowColor="#000000"
                android:shadowRadius="6" />

        </LinearLayout>

        <!-- Scrollable Catalog Rows: floats seamlessly over full-screen backdrop -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/layoutCatalogRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:background="@android:color/transparent"
                    android:paddingTop="0dp"
                    android:paddingBottom="40dp" />

            </androidx.core.widget.NestedScrollView>

            <!-- Global Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBarHome"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/active_accent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>
    <!-- End of layoutMainContent -->

    <!-- 3. Left Navigation Rail (Auto-Hide Overlay Drawer, Nuvio / Stremio / Netflix TV Style)
         Auto-hides by default; slides in from the left over the content when DPAD_LEFT is clicked at position 0 -->
    <LinearLayout
        android:id="@+id/layoutNavRail"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_sidebar_rail"
        android:elevation="16dp"
        android:visibility="gone">

        <!-- Brand Header (NuVibe TV Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NUVIBE"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_tv_accent_badge"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="TV"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnNavCatalog"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_topbar_pill"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_home"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary_text"
            android:gravity="center_vertical|start"
            android:text="Inicio"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnNavMyList"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_topbar_pill"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_star"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary_text"
            android:gravity="center_vertical|start"
            android:text="Mi Lista"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnNavSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_topbar_pill"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary_text"
            android:gravity="center_vertical|start"
            android:text="Buscar"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnNavRefresh"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_topbar_pill"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary_text"
            android:gravity="center_vertical|start"
            android:text="Actualizar"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_topbar_pill"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_settings"
            android:drawablePadding="12dp"
            android:drawableTint="@color/primary_text"
            android:gravity="center_vertical|start"
            android:text="Ajustes"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
