<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="false">

    <!-- Primary TV WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Fullscreen Video Container (For WebChromeClient HTML5 Video) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Sleek Top Page Loading Progress Bar (Hidden per user request) -->
    <ProgressBar
        android:id="@+id/pageLoadingBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="#9D4EDD"
        android:visibility="gone" />

    <!-- Hidden Left Settings & Source Drawer (Activated on Far Left Cursor) -->
    <LinearLayout
        android:id="@+id/sidebarDrawer"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_sidebar"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="20dp"
        android:translationX="-330dp"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎌 Anime TV"
                    android:textColor="#E0AAFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Settings &amp; Sources"
                    android:textColor="#9D4EDD"
                    android:textSize="12sp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#3D2660" />

                <!-- Quick Settings -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUICK SETTINGS"
                    android:textColor="#C77DFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Fullscreen Toggle -->
                <TextView
                    android:id="@+id/btnSidebarFullscreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="⛶  Toggle Fullscreen"
                    android:textColor="#FFD600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- AdBlocker Toggle -->
                <TextView
                    android:id="@+id/btnSidebarAdBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="🛡️  AdBlocker: ON"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Pointer Mode / Scroll Mode Toggle -->
                <TextView
                    android:id="@+id/btnSidebarMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="🖱️  Mode: Pointer"
                    android:textColor="#E0AAFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#3D2660" />

                <!-- Anime Sources -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANIME SOURCES"
                    android:textColor="#C77DFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Source 1: 9Anime -->
                <TextView
                    android:id="@+id/btnSource9Anime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_active_source"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="●  9Anime"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Source 2: GogoAnime -->
                <TextView
                    android:id="@+id/btnSourceGogoAnime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="○  GogoAnime"
                    android:textColor="#F0F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Source 3: SoloLatino -->
                <TextView
                    android:id="@+id/btnSourceSoloLatino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="○  SoloLatino (Español)"
                    android:textColor="#F0F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Source 4: AnimeFlix -->
                <TextView
                    android:id="@+id/btnSourceAnimeFlix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="○  AnimeFlix"
                    android:textColor="#F0F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Source 5: AnimeYT -->
                <TextView
                    android:id="@+id/btnSourceAnimeYT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:text="○  AnimeYT (Español)"
                    android:textColor="#F0F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#3D2660" />

                <!-- Navigation Shortcuts -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHORTCUTS"
                    android:textColor="#C77DFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Home -->
                <TextView
                    android:id="@+id/btnSidebarHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="⌂  Home"
                    android:textColor="#F0F0FF"
                    android:textSize="13sp" />

                <!-- Reload -->
                <TextView
                    android:id="@+id/btnSidebarReload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="↻  Reload Page"
                    android:textColor="#F0F0FF"
                    android:textSize="13sp" />

                <!-- Close Sidebar -->
                <TextView
                    android:id="@+id/btnSidebarClose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_sidebar_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="✕  Close Sidebar"
                    android:textColor="#FF79C6"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Virtual Cursor View for TV Remote Navigation (renders on top of sidebar) -->
    <com.example.animetv.tv.VirtualCursorView
        android:id="@+id/virtualCursorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="35dp"
        android:focusable="false"
        android:clickable="false" />

    <!-- Top OSD Status Bar (Hidden per user request: chips cannot be clicked on TV) -->
    <LinearLayout
        android:id="@+id/osdTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false">

        <!-- Quick Fullscreen Button -->
        <TextView
            android:id="@+id/btnFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_osd_badge"
            android:text="⛶ Fullscreen"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- AdBlock Shield Badge -->
        <TextView
            android:id="@+id/txtAdBlockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_osd_badge"
            android:text="🛡️ AdBlock ON (0)"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Navigation Mode Badge -->
        <TextView
            android:id="@+id/txtNavModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_osd_badge"
            android:text="🖱️ Pointer Mode"
            android:textColor="#E0AAFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Remote Controls Guide (Auto-fades out after 5 seconds) -->
    <LinearLayout
        android:id="@+id/osdControlsGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_panel"
        android:orientation="horizontal"
        android:elevation="40dp"
        android:focusable="false"
        android:clickable="false">

        <TextView
            android:id="@+id/txtGuideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 D-Pad: Move Pointer  •  Left Edge / [MENU]: Settings  •  OK: Click  •  [BACK]: Back"
            android:textColor="#F0F0FF"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
