<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_canvas">

    <!-- Scrollable Main View: large reactive hero on top, all catalog rows scroll continuously
         beneath it — matching the real Nuvio/Stremio home layout (verified against actual
         reference screenshots), not the earlier one-row-at-a-time "board" experiment. -->
    <!-- Fixed Hero: ~42% screen height (270dp) pinned at the top.
         Art sits to the right, protected by left and bottom gradients.
         Reflects whichever card currently has D-pad focus in the rows below.
         Stays fixed at all times while catalog rows scroll beneath it. -->
    <FrameLayout
        android:id="@+id/layoutHeroBanner"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:background="@color/surface_layer">

        <ImageView
            android:id="@+id/imgHeroBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Left-to-right gradient: ensures title, metadata, and synopsis are crisp
             over any backdrop while letting the artwork shine on the right -->
        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewHeroLeftGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom gradient: dissolves hero smoothly into canvas color -->
        <com.example.animetv.ui.GradientOverlayView
            android:id="@+id/viewHeroBottomGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating pill nav bar, overlaid on the hero image -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/safe_zone_margin"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NuVibe TV"
                android:textColor="@color/primary_text"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:shadowColor="#000000"
                android:shadowRadius="8" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnNavCatalog"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_topbar_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text=""
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnNavMyList"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_topbar_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text=""
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnNavSearch"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_topbar_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text=""
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnNavRefresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_topbar_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text="↻"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_topbar_pill"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="12dp"
                android:text="⚙"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Hero Info Container (Title, Metadata, Synopsis) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/safe_zone_margin"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/txtHeroTitle"
                android:layout_width="600dp"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#000000"
                android:shadowRadius="10" />

            <!-- Quick-scan metadata line: year • rating • genres/seasons -->
            <TextView
                android:id="@+id/txtHeroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowRadius="6"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtHeroSynopsis"
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#C5C8D4"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:shadowColor="#000000"
                android:shadowRadius="6" />

        </LinearLayout>

    </FrameLayout>

    <!-- Scrollable Catalog Rows: occupies remaining screen height below fixed hero -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutCatalogRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:paddingTop="270dp"
                android:paddingBottom="40dp" />

        </androidx.core.widget.NestedScrollView>

        <!-- Global Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarHome"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/active_accent"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
