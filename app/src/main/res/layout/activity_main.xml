<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="false">

    <!-- Structural stack: the top bar is a real fixed header with its own permanent row (not an
         overlay) - GeckoView and its cursor overlay fill whatever space is left below it. Hidden
         only during actual fullscreen video playback (see MainActivity.handleFullscreenChange),
         which lets GeckoView expand to fill the whole screen automatically via layout_weight. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar: sources + settings gear. A PERSISTENT header, always visible during normal
             browsing (see MainActivity's class comment above setupTopBar() for why this replaced
             an earlier hide/show design). Reached by moving focus UP out of the page once it's
             scrolled to the top, or via MENU as a direct shortcut; left via DOWN or BACK. Text
             sizes/padding/focus-stroke widths here are tuned for legibility on a 10-foot, 75in+
             Google TV screen, not phone-app scale - see bg_topbar_item.xml/bg_topbar_active_source.xml
             for the matching focus-ring stroke widths. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_topbar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:elevation="35dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- My List: shows saved via long-press-OK anywhere in the app (see
                         MainActivity.handleLongPressFavorite()). Not a real source/URL - selecting
                         it swaps GeckoView out for a native favoritesScreen grid below, see
                         switchSource()'s SOURCE_FAVORITES branch. -->
                    <TextView
                        android:id="@+id/btnSourceFavorites"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="★  My List"
                        android:textColor="#FFD600"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 1: 9Anime -->
                    <TextView
                        android:id="@+id/btnSource9Anime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_active_source"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="●  9Anime"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 2: GogoAnime -->
                    <TextView
                        android:id="@+id/btnSourceGogoAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  GogoAnime"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 3: SoloLatino -->
                    <TextView
                        android:id="@+id/btnSourceSoloLatino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  SoloAnime ES"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source: SoloLatino Home (movies/series/doramas catalog, not just anime) -->
                    <TextView
                        android:id="@+id/btnSourceSoloLatinoHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  SoloStream ES"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 4: AnimeFlix -->
                    <TextView
                        android:id="@+id/btnSourceAnimeFlix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  AnimeFlix"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 5: AnimeYT -->
                    <TextView
                        android:id="@+id/btnSourceAnimeYT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  AnimeYT (Español)"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Source 6: JKAnime -->
                    <TextView
                        android:id="@+id/btnSourceJKAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_topbar_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:text="○  JKAnime (Español)"
                        android:textColor="#F0F0FF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Settings gear - pinned at the far right, outside the scrollable tab area -->
            <TextView
                android:id="@+id/btnTopBarSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_topbar_item"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:text="⚙"
                android:textColor="#FFD600"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Content area: primary TV browsing engine + its cursor overlay, filling whatever space
             is left below the top bar. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.mozilla.geckoview.GeckoView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- My List grid - occupies the exact same slot as GeckoView, shown/hidden opposite
                 it (see switchSource()'s SOURCE_FAVORITES branch). D-pad UP/DOWN/LEFT/RIGHT/OK
                 here are NOT routed through virtualCursorView - MainActivity.dispatchKeyEvent lets
                 them fall through to Android's normal focus-search/click handling instead, since
                 this is a real focusable Android view grid, not the page's custom reticle model. -->
            <FrameLayout
                android:id="@+id/favoritesScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/favoritesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="16dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/favoritesEmptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No shows saved yet.\nHold OK (remote) or press and hold a show (touch) to add it here."
                    android:textAlignment="center"
                    android:textColor="#A090C0"
                    android:textSize="20sp"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Top page-loading progress bar - shown while a source switch or reload is in
                 flight (see MainActivity.switchSource()/attachGeckoSessionDelegates()'s
                 onPageStart/onPageStop), so a top-bar tab press has immediate visible feedback
                 instead of appearing to require a second press. -->
            <ProgressBar
                android:id="@+id/pageLoadingBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:max="100"
                android:progress="0"
                android:progressTint="#9D4EDD"
                android:visibility="gone" />

            <!-- Virtual Cursor View for TV Remote Navigation - confined to the content area, not
                 the top bar, so its reticle bounds match the actual page viewport. -->
            <com.example.animetv.tv.VirtualCursorView
                android:id="@+id/virtualCursorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="37dp"
                android:focusable="false"
                android:clickable="false" />

        </FrameLayout>

    </LinearLayout>

    <!-- Settings panel - small floating popup opened from the top bar's gear icon. Holds what
         used to be the sidebar's SETTINGS/SHORTCUTS sections. The 66dp marginTop below is only a
         same-frame fallback; MainActivity.initViews() overwrites it with topBar's real measured
         height once topBar lays out, so it stays correct if topBar's padding/text size changes. -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_popup_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:elevation="36dp"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true">

        <!-- Fullscreen Toggle -->
        <TextView
            android:id="@+id/btnSettingsFullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_topbar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="⛶  Toggle Fullscreen"
            android:textColor="#FFD600"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Pointer Mode / Scroll Mode Toggle -->
        <TextView
            android:id="@+id/btnSettingsMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_topbar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="📜  Mode: Scroll"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Home -->
        <TextView
            android:id="@+id/btnSettingsHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_topbar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="⌂  Home"
            android:textColor="#F0F0FF"
            android:textSize="16sp" />

        <!-- Reload -->
        <TextView
            android:id="@+id/btnSettingsReload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_topbar_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="↻  Reload Page"
            android:textColor="#F0F0FF"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Bottom Remote Controls Guide (Auto-fades out after 5 seconds). Starts invisible - shown
         via scheduleGuideDismiss() only once the first page actually finishes loading (see
         onPageStop, MainActivity.kt), not at app launch, so its 5-second timer doesn't race the
         initial page load and burn down against a blank/loading screen. -->
    <LinearLayout
        android:id="@+id/osdControlsGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_panel"
        android:orientation="horizontal"
        android:elevation="40dp"
        android:visibility="invisible"
        android:focusable="false"
        android:clickable="false">

        <TextView
            android:id="@+id/txtGuideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 D-Pad: Scroll  •  UP at top / [MENU]: Sources &amp; Settings  •  OK: Click  •  [BACK]: Back"
            android:textColor="#F0F0FF"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
