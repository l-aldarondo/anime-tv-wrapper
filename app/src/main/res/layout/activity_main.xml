<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090A0E"
    android:focusable="false">

    <!-- Structural Stack: Top Bar + Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar: Netflix / Prime Video Style Cinematic Header -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12141C"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:elevation="20dp"
            android:focusable="false">

            <!-- Netflix style brand logo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANIME"
                    android:textColor="#E50914"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_netflix_badge"
                    android:text="LITE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Scrollable source selector tabs -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Source 1: 9Anime -->
                    <TextView
                        android:id="@+id/btnSource9Anime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_active_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="● 9Anime"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 2: GogoAnime -->
                    <TextView
                        android:id="@+id/btnSourceGogoAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ GogoAnime"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 3: SoloLatino -->
                    <TextView
                        android:id="@+id/btnSourceSoloLatino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ SoloAnime"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 4: SoloStream (Películas/Series) -->
                    <TextView
                        android:id="@+id/btnSourceSoloLatinoHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ SoloStream"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 5: AnimeFlix -->
                    <TextView
                        android:id="@+id/btnSourceAnimeFlix"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ AnimeFlix"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 6: AnimeYT -->
                    <TextView
                        android:id="@+id/btnSourceAnimeYT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ AnimeYT"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Source 7: JKAnime -->
                    <TextView
                        android:id="@+id/btnSourceJKAnime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_netflix_tab"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:text="○ JKAnime"
                        android:textColor="#E0E0FF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Quick Action controls (Right side) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <!-- Cinema View toggle (removes site clutter) -->
                <TextView
                    android:id="@+id/btnTopBarCinema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_netflix_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:text="🍿 Cinema"
                    android:textColor="#FFD54F"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Mode toggle (Scroll vs Pointer) -->
                <TextView
                    android:id="@+id/btnTopBarMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_netflix_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="10dp"
                    android:text="📜 Scroll"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Reload Page -->
                <TextView
                    android:id="@+id/btnTopBarReload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_netflix_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="↻"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main Web & Video Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- High-Performance Native Android WebView -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <!-- Netflix Red Loading Bar -->
            <ProgressBar
                android:id="@+id/pageLoadingBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:progressTint="#E50914"
                android:visibility="gone" />

            <!-- Virtual Cursor Overlay for D-Pad Remote Navigation -->
            <com.example.animetv.tv.VirtualCursorView
                android:id="@+id/virtualCursorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="30dp"
                android:focusable="false"
                android:clickable="false" />

        </FrameLayout>

    </LinearLayout>

    <!-- Netflix / Prime Video Style HUD Controls Bar (Auto-hides or toggled via remote) -->
    <LinearLayout
        android:id="@+id/hudPlayerBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_hud_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="45dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnHudRewind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="⏪ 10s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHudPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="⏯ Play/Pause"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHudForward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="⏩ 10s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- High-value anime feature: Skip Intro (+85s) -->
        <TextView
            android:id="@+id/btnHudSkipIntro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="⏩ Skip Intro (+85s)"
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHudNextEp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="⏭ Next Ep"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnHudFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hud_button"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="⛶ Fullscreen"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TV Remote Controls Guide (Auto-fades out after 5s) -->
    <LinearLayout
        android:id="@+id/osdControlsGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_osd_panel"
        android:orientation="horizontal"
        android:elevation="40dp"
        android:visibility="gone"
        android:focusable="false"
        android:clickable="false">

        <TextView
            android:id="@+id/txtGuideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 D-Pad: Scroll  •  UP at top: Sources  •  OK: Click  •  MENU: Cinema Controls"
            android:textColor="#F0F0FF"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
