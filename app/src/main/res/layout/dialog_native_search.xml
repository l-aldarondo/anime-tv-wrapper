<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_panel"
    android:padding="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Búsqueda Universal de Anime"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search Input Field -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editSearchInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_topbar_item"
            android:paddingHorizontal="16dp"
            android:hint="Escribe el nombre del anime..."
            android:textColorHint="#70748A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/btnExecuteSearch"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_topbar_active_source"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="24dp"
            android:text="Buscar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search Progress Spinner -->
    <ProgressBar
        android:id="@+id/searchProgressBar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="#E50914"
        android:visibility="gone" />

    <!-- Results Status Label -->
    <TextView
        android:id="@+id/txtSearchResultsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Resultados:"
        android:textColor="#FFD54F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Results RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSearchResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
