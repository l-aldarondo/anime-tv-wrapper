<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvio / Stremio unified episode card: full-bleed 16:9 still image with gradient overlay
     and all episode info (badge, title, synopsis, duration, rating, air date) over the image.
     CardView with 12dp radius strictly clips both the screenshot still and the gradient so
     no raw image colors can ever peek out at the bottom corners. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="150dp"
    android:layout_marginEnd="14dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardBackgroundColor="#1A1C24">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-bleed Episode Still / Screenshot -->
        <ImageView
            android:id="@+id/imgEpisodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Dark Gradient Overlay for Crisp Text Contrast (clipped uniformly by CardView) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_episode_card" />

        <!-- Top Left: Watched Circle Indicator -->
        <TextView
            android:id="@+id/txtEpisodeWatchedBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_watched_circle"
            android:gravity="center"
            android:text="✓"
            android:textColor="#052512"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Top Right: Episode Pill Badge and Torrent indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtEpisodeTorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_badge_tor"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="⚡ TOR"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtEpisodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_episode"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

        <!-- Bottom Content Overlay: Title, Synopsis, Metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp">

            <!-- Episode Title -->
            <TextView
                android:id="@+id/txtEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#000000"
                android:shadowRadius="6" />

            <!-- 2-Line Synopsis Overlaid on Image -->
            <TextView
                android:id="@+id/txtEpisodeSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#C5C8D4"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:shadowColor="#000000"
                android:shadowRadius="4" />

            <!-- Bottom Metadata Row: Duration • IMDb • Air Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtEpisodeDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFD54F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEpisodeRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#33FFD54F"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtEpisodeReleaseDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8E93A3"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Embedded Progress Bar on Bottom Edge -->
        <ProgressBar
            android:id="@+id/progressEpisodeWatched"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/active_accent"
            android:progressBackgroundTint="#00000000"
            android:visibility="gone" />

        <!-- Focus border overlay: perfectly matches the 12dp CardView contour -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_episode_card" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
