<?xml version="1.0" encoding="utf-8"?>
<!-- Compact Stremio-style layout: thumbnail and text sit side by side instead of stacked, which
     is what actually saves the vertical space the old (image-on-top, text-below) card spent on
     duplicating layout height for both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/bg_favorite_card">

    <!-- Episode Screenshot Still Image (16:9) -->
    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="72dp"
        android:background="@color/surface_layer">

        <ImageView
            android:id="@+id/imgEpisodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- Watched Checkmark Badge (Top Right) -->
        <TextView
            android:id="@+id/txtEpisodeWatchedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_watched_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="✓"
            android:textColor="#00E676"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Episode Details Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Season & Episode Tag (+ release date folded into the same line to save a row) -->
            <TextView
                android:id="@+id/txtEpisodeBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Watch State / Progress -->
            <TextView
                android:id="@+id/txtEpisodeProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#81C784"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Release Date -->
        <TextView
            android:id="@+id/txtEpisodeReleaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/secondary_text"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- Real Episode Name / Chapter Title -->
        <TextView
            android:id="@+id/txtEpisodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Episode Synopsis -->
        <TextView
            android:id="@+id/txtEpisodeSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/secondary_text"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Direct actions for this specific episode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEpisodeWeb"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/bg_netflix_btn_play"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="0dp"
                android:text="▶ WEB"
                android:textColor="@color/color_netflix_btn_play"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEpisodeTorrent"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="0dp"
                android:text="⚡ TOR"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
