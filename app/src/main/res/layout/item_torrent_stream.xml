<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_torrent_item_selector"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Torrent Release Title -->
    <TextView
        android:id="@+id/txtTorrentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Resolution Badge (1080p / 720p) -->
        <TextView
            android:id="@+id/txtBadgeResolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:text="1080p"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Language Badge (Latino / Castellano / Dual) -->
        <TextView
            android:id="@+id/txtBadgeLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_pill"
            android:text="🇪🇸 Latino"
            android:textColor="#69F0AE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Seeders Badge -->
        <TextView
            android:id="@+id/txtBadgeSeeders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_pill"
            android:text="🌱 45 seeds"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- File Size Badge -->
        <TextView
            android:id="@+id/txtBadgeSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_pill"
            android:text="1.4 GB"
            android:textColor="#B0B3C6"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Source / Tracker Badge -->
        <TextView
            android:id="@+id/txtBadgeProvider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7A7E9D"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
