<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_panel"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Ajustes de Streaming y Filtros"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Personaliza la calidad, idiomas preferidos y comportamiento de reproducción en TV."
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

        <!-- 1. Calidad Máxima -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calidad Máxima de Torrents:"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbQuality1080p"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="1080p (Óptimo)"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="12sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbQuality720p"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="720p"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="12sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbQualityAll"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="Cualquiera (HD)"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="12sp"
                android:focusable="true" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtQualitySummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Activo: 1080p (Óptimo)"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chkAllow4k"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Permitir 4K / UHD (desactivado por defecto para proteger la RAM de la tele)"
            android:textColor="@color/secondary_text"
            android:textSize="11sp"
            android:focusable="true" />

        <!-- 2. Filtro de Idiomas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Filtro de Idiomas Preferido:"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbLangSpanish"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="🇪🇸 Solo Español"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbLangDual"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="🌐 Dual Audio"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbLangSub"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="💬 Sub / Orig"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbLangAll"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="🌍 Todos"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtLanguageSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Activo: Solo Español"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/chkPreferSpanish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Priorizar Español en la lista (si se desactiva, ordena por más semillas)"
            android:textColor="@color/secondary_text"
            android:textSize="11sp"
            android:focusable="true" />

        <!-- 3. Acción al pulsar un Episodio en el Carrusel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Al pulsar una tarjeta de episodio en la lista:"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgEpisodeAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbActionWeb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="▶ WEB"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbActionTorrent"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="⚡ TOR"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbActionAsk"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="❓ Preguntar"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtActionSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Activo: ▶ WEB"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 4. Filtro de Tamaño Máximo de Archivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tamaño Máximo de Archivo:"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgFileSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSizeAll"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="Sin límite"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbSize15Gb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="≤ 1.5 GB"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbSize3Gb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="≤ 3 GB"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbSize6Gb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="≤ 6 GB"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

            <RadioButton
                android:id="@+id/rbSize12Gb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filter_chip_selector"
                android:button="@null"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="≤ 12 GB"
                android:textColor="@color/color_filter_chip_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:focusable="true" />

        </RadioGroup>

        <TextView
            android:id="@+id/txtFileSizeSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Activo: Sin límite"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 5. Opciones de Servidor / Red (Avanzado) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Servidor de Streaming (Opcional - por defecto Nova Player):"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTorrServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_netflix_tab"
            android:padding="10dp"
            android:hint="http://127.0.0.1:8090"
            android:textColorHint="#60647A"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:inputType="textUri"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Indexador de Torrents (Jackett o Prowlarr - Opcional):"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editJackettUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_netflix_tab"
                android:padding="10dp"
                android:hint="Jackett o Prowlarr URL"
                android:textColorHint="#60647A"
                android:textColor="@color/primary_text"
                android:textSize="13sp"
                android:inputType="textUri"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <EditText
                android:id="@+id/editJackettApiKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_netflix_tab"
                android:padding="10dp"
                android:hint="API Key (Jackett/Prowlarr)"
                android:textColorHint="#60647A"
                android:textColor="@color/primary_text"
                android:textSize="13sp"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnCancelTorrentSettings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_netflix_btn_secondary"
                android:paddingHorizontal="18dp"
                android:text="Cancelar"
                android:textColor="@color/primary_text"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />

            <Button
                android:id="@+id/btnSaveTorrentSettings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_netflix_btn_play"
                android:paddingHorizontal="22dp"
                android:text="💾 Guardar Ajustes"
                android:textColor="@color/color_netflix_btn_play"
                android:textSize="13sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
