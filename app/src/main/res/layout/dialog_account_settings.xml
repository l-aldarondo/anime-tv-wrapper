<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_panel"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔑 Cuenta Maestra (Auto-Completar)"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Explanation -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Guarda tu usuario y contraseña aquí para auto-completar los formularios de inicio de sesión en todas las páginas sin escribir con el control remoto."
        android:textColor="#B0B3C6"
        android:textSize="13sp" />

    <!-- Username Input Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Usuario / Correo Electrónico:"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editMasterUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_netflix_tab"
        android:padding="12dp"
        android:hint="ejemplo@correo.com"
        android:textColorHint="#60647A"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:inputType="textEmailAddress"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Password Input Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Contraseña:"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editMasterPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_netflix_tab"
        android:padding="12dp"
        android:hint="••••••••••••"
        android:textColorHint="#60647A"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/btnCancelCredentials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_netflix_tab"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="Cancelar"
            android:textColor="#E0E0FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnAutoFillNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_netflix_tab"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="⚡ Auto-Completar"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnSaveCredentials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_netflix_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="💾 Guardar"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

</LinearLayout>
