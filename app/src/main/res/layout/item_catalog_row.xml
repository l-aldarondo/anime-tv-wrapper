<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Row Title -->
    <TextView
        android:id="@+id/txtRowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/safe_zone_margin"
        android:layout_marginBottom="10dp"
        style="@style/TextAppearance.SectionHeader" />

    <!-- Horizontal Cards RecyclerView. clipChildren="false" lets a focused card's 110% scale-up
         glow render fully outside its normal item bounds instead of being cut off — otherwise
         only whichever edges happen to fall inside the RecyclerView's own bounds show the glow,
         which looked inconsistent from card to card. The extra vertical padding gives the
         scaled-up card room to breathe without visually colliding with the row above/below. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRowCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/safe_zone_margin"
        android:paddingEnd="@dimen/safe_zone_margin"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:overScrollMode="never" />

</LinearLayout>
