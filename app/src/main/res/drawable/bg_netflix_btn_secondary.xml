<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote: Netflix Red with clean white border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B20710" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Idle state: Translucent dark grey pill with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#50333333" />
            <stroke android:width="1dp" android:color="#80666666" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
