<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#3B4252" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#2E3440" />
        </shape>
    </item>
    <!-- Idle state: sleek circular translucent dark button -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#262C38" />
            <stroke android:width="1dp" android:color="#3B4252" />
        </shape>
    </item>
</selector>
