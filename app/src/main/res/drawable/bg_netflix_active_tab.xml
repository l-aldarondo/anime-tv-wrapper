<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/active_accent"
                android:endColor="@color/active_accent_deep"
                android:angle="45" />
            <stroke android:width="3dp" android:color="@color/primary_text" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/active_accent"
                android:endColor="@color/active_accent_deep"
                android:angle="45" />
            <stroke android:width="1dp" android:color="@color/active_accent_soft" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
