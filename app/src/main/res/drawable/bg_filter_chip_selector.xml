<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked + Focused on TV (High-contrast active selection) -->
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Checked (Selected) State: Radiant Neon Cyan Fill -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF" />
            <stroke android:width="2dp" android:color="#3DF5FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Focused (Unchecked) State: Slate Background with Crisp White Stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#282C3D" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#005B6E" />
            <stroke android:width="1dp" android:color="#00E5FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Default Idle State: Dark Background with Subtle Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1C26" />
            <stroke android:width="1dp" android:color="#2E3244" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
