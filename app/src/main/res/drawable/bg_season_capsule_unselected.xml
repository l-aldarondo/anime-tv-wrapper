<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV remote (Unselected state) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="3dp" android:color="@color/active_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Idle state (Unselected) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20232B" />
            <stroke android:width="1dp" android:color="#3A3F50" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
