<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: vibrant indigo glow border matching app design system -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Soft outer glow (blurred effect via semi-transparent wider stroke) -->
            <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="4dp" android:color="#557C6AF7" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Inner crisp border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="3dp" android:color="@color/active_accent_soft" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed: white flash -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Normal idle: invisible (no border clutter) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</selector>
