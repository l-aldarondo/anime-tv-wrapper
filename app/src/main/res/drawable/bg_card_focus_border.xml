<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote D-Pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="@color/active_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="@color/active_accent_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Normal idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
