<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV remote (Selected state) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/active_accent" />
            <stroke android:width="3dp" android:color="@color/primary_text" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Idle state (Selected) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/active_accent" />
            <stroke android:width="1dp" android:color="@color/active_accent_soft" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
