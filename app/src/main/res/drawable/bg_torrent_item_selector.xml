<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on Android TV: Highlighted border and deep red accent -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A1820" />
            <stroke android:width="3dp" android:color="#00E5FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A2028" />
            <stroke android:width="2dp" android:color="#00E5FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1C26" />
            <stroke android:width="1dp" android:color="#2E3244" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
