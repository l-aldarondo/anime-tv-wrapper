<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote D-Pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_layer_focused" />
            <stroke android:width="@dimen/focus_border_width" android:color="@color/active_accent" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_layer_focused" />
            <stroke android:width="@dimen/focus_border_width" android:color="@color/active_accent_soft" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
    <!-- Normal idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_layer" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="@dimen/card_corner_radius" />
        </shape>
    </item>
</selector>
