<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote D-Pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#231F20" />
            <stroke android:width="3dp" android:color="#E50914" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#381014" />
            <stroke android:width="3dp" android:color="#FF3333" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Normal idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141722" />
            <stroke android:width="1dp" android:color="#242838" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
