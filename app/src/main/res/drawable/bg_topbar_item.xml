<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/active_accent" />
            <stroke android:width="3dp" android:color="@color/primary_text" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/active_accent_soft" />
            <stroke android:width="2dp" android:color="@color/primary_text" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_layer" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
