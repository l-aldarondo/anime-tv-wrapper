<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused on TV remote -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3D1D69" />
            <stroke android:width="3dp" android:color="#E0AAFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A2A9A" />
            <stroke android:width="2dp" android:color="#FFD600" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Default idle state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#211832" />
            <stroke android:width="1dp" android:color="#3A2855" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
